---
import Township from '../layouts/Township.astro';
import { faq } from '../data/township';
---
<Township title="Frequently asked questions">
  <div class="wrap">
    <h1>Frequently asked questions</h1>
    {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </div>
</Township>
