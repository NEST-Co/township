---
import Township from '../layouts/Township.astro';
import { notices, fmtDate, dateParts } from '../data/township';
---
<Township title="Notices" heading="Notices" lead="Road closures, pickups and hearings, newest first.">
  <div class="wrap body" style="max-width:860px">
    {notices.map((n) => { const p = dateParts(n.date); return (
      <article class="notice">
        <div class="datebox" aria-hidden="true"><span class="m">{p.m}</span><span class="d">{p.d}</span></div>
        <div><h2 style="font-size:1.25rem;margin:0 0 .25rem">{n.title}</h2><p><span class="visually-hidden">Posted </span><time datetime={n.date}>{fmtDate(n.date)}</time></p><p style="color:var(--ink);margin-top:.35rem">{n.body}</p></div>
      </article>
    ); })}
  </div>
</Township>
