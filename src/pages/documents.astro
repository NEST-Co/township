---
import Township from '../layouts/Township.astro';
import Icon from '../components/Icon.astro';
import { documents, fmtDate } from '../data/township';
const types = [...new Set(documents.map((d) => d.type))].sort();
---
<Township title="Documents" heading="Documents" lead="Forms, minutes, budgets and resolutions. Each file shows its type and size.">
  <div class="wrap body">
    <p>Need one in another format? <a href="/contact">Ask the office</a>.</p>
    <label for="type">Show</label>
    <select id="type"><option value="">All documents</option>{types.map((t) => <option>{t}</option>)}</select>
    <p id="status" role="status" class="visually-hidden"></p>
    <ul id="docs" class="docs">
      {documents.map((d) => (
        <li data-type={d.type}>
          <span class="ico"><Icon name="doc" /></span>
          <span><a href={d.file}>{d.title}</a><span class="meta">{d.format}, {d.size} · <time datetime={d.date}>{fmtDate(d.date)}</time></span></span>
          <span class="pill">{d.type}</span>
        </li>
      ))}
    </ul>
  </div>
</Township>
<script>
  const sel = document.querySelector<HTMLSelectElement>('#type')!;
  const items = [...document.querySelectorAll<HTMLElement>('#docs li')];
  const status = document.querySelector('#status')!;
  sel.addEventListener('change', () => {
    let n = 0;
    items.forEach((li) => { const show = !sel.value || li.dataset.type === sel.value; li.hidden = !show; if (show) n++; });
    status.textContent = `${n} documents shown`;
  });
</script>
