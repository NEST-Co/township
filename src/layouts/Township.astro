---
import Base from './Base.astro';
import { site, nav } from '../data/township';
import Logo from '../components/Logo.astro';
interface Props { title: string; description?: string }
const { title, description = `${title}: information and services from ${site.name}, a fictional township.` } = Astro.props;
const path = Astro.url.pathname;
---
<Base title={title} description={description} siteName={site.name}>
  <div slot="header" class="site-head">
    <div class="alert"><div class="wrap"><strong>Emergency? Call 911.</strong> For non-emergency township business call {site.phone}.</div></div>
    <div class="wrap bar">
      <a class="brand" href="/"><Logo /><span>{site.name}</span></a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <slot />
  <div slot="footer" class="site-foot">
    <div class="wrap">
      <p><strong>{site.name}</strong><br />{site.address}<br />{site.phone} · <a href={`mailto:${site.email}`}>{site.email}</a><br />{site.hours}</p>
      <p><a href="/accessibility">Accessibility statement</a> · <a href="/faq">Frequently asked questions</a></p>
    </div>
  </div>
</Base>
<style is:global>
  :root { --brand:#1E5A3C; }
  .site-head{border-bottom:4px solid var(--brand)}
  .bar{display:flex;flex-wrap:wrap;gap:.5rem 2rem;align-items:center;justify-content:space-between;padding-block:1rem}
  .brand{display:inline-flex;align-items:center;gap:.6rem;font:700 1.5rem var(--display);color:var(--brand);text-decoration:none}
  .alert{background:var(--brand);color:#fff;font-size:.95rem;padding:.45rem 0}
  .hero{background:var(--surface);border-bottom:1px solid var(--line);padding-block:2.5rem}
  .hero h1{font-size:clamp(2rem,5vw,3rem);margin:0 0 .5rem}
  .hero p{font-size:1.25rem;margin:0}
  .two{display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
  .card::after{content:" \2192"}
  details{border-bottom:1px solid var(--line);padding:.75rem 0}
  summary{cursor:pointer;font-weight:700;min-height:44px;display:flex;align-items:center}
  .people{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));list-style:none;padding:0}
  .people li{border-left:4px solid var(--brand);padding:.25rem 1rem}
  .people strong{display:block}
  select{font:inherit;min-height:44px;padding:.4rem .6rem;border:2px solid var(--ink);border-radius:6px;background:var(--bg);color:var(--ink)}
  label{font-weight:700;margin-right:.5rem}
  @media (max-width:640px){
    table.stack thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
    table.stack tr{display:block;border-bottom:1px solid var(--line);padding:.6rem 0}
    table.stack th,table.stack td{display:block;border:0;padding:.15rem 0}
    table.stack td[data-label]::before{content:attr(data-label) ": ";font-weight:700}
  }
  @media print{.skip-link,.concept-note,nav,.alert{display:none}a[href^="http"]::after{content:" (" attr(href) ")"}}
  nav ul{display:flex;flex-wrap:wrap;gap:.25rem 1.25rem;list-style:none;margin:0;padding:0}
  nav a{display:inline-block;padding:.6rem .25rem;color:var(--ink);font-weight:600}
  nav a[aria-current="page"]{color:var(--brand);text-decoration-thickness:3px}
  main{padding-block:2rem 4rem}
  .site-foot{background:var(--surface);border-top:1px solid var(--line);padding-block:2rem}
  .grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));padding:0;list-style:none}
  .card{display:block;border:1px solid var(--line);border-radius:8px;padding:1.1rem;background:var(--bg);font-weight:700;text-decoration:none}
  .card:hover{border-color:var(--brand)}
  table{border-collapse:collapse;width:100%}
  th,td{text-align:left;padding:.7rem;border-bottom:1px solid var(--line);vertical-align:top}
  caption{text-align:left;font-weight:700;padding-bottom:.5rem}
</style>
