---
import Base from './Base.astro';
import { site, nav } from '../data/township';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import '../styles/township.css';
interface Props { title: string; description?: string; heading?: string; lead?: string; eyebrow?: string; home?: boolean }
const { title, description = `${title}: information and services from ${site.name}, a fictional township.`, heading, lead, eyebrow, home = false } = Astro.props;
const path = Astro.url.pathname;
---
<Base title={title} description={description} siteName={site.name}>
  <div slot="header" class="site-head">
    <div class="alert"><div class="wrap">
      <span><strong>Emergency? Call 911.</strong></span>
      <span>Township office: <a href={`tel:${site.phone.replace(/[^0-9]/g, '')}`}>{site.phone}</a></span>
    </div></div>
    <div class="wrap bar">
      <a class="brand" href="/"><Logo /><span class="brand-text"><span class="brand-name">{site.name}</span><span class="brand-sub">Township government</span></span></a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  {!home && heading && (
    <div class="page-band">
      <div class="wrap">
        <p class="crumbs"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>{eyebrow ?? title}</span></p>
        <h1>{heading}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
    </div>
  )}
  <slot />
  <div slot="footer" class="site-foot">
    <div class="wrap foot-grid">
      <div>
        <p class="foot-name"><Logo /> {site.name}</p>
        <p class="foot-line"><Icon name="pin" size={18} /> {site.address}</p>
        <p class="foot-line"><Icon name="phone" size={18} /> {site.phone}</p>
        <p class="foot-line"><Icon name="clock" size={18} /> {site.hours}</p>
      </div>
      <div>
        <h2>Around the site</h2>
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>In an emergency</h2>
        <p class="e911">911</p>
        <p>Fire &amp; EMS non-emergency line: (555) 010-0150</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    </div>
    <div class="wrap legal"><a href="/accessibility">Accessibility statement</a> <span aria-hidden="true">·</span> <a href="/faq">Frequently asked questions</a></div>
  </div>
</Base>
